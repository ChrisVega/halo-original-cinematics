(script static void probe_ce_cmds
  (begin
    (camera_set autumn_glory_1a2 0)
    (object_type_predict captain)
    (unit_suspended)
    (switch_bsp 7)
    (cinematic_set_near_clip_distance 10)
    (player_camera_control)
    (object_pvs_set_camera autumn_glory_1a)
    (fade_in 0.0 0.0 0.0 90)
    (sleep 180)
    (object_create chief)
    (object_teleport player0 player0_x10_base)
    (bomber_setup)
    (camera_control true)
    (cinematic_start)
    (cinematic_set 1)
    (cinematic_in_progress)
    (object_destroy glory_halo)
    (sound_looping_start sound\sinomatixx\x10_music01 none)
    (print_if b_debug_gameplay hi)
  )
)
