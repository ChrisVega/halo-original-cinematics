(script static void (tp_crazy_marine1)
	(performance_play_line "initialize")
	(performance_play_line "standing_idle")
	(sleep_until
		(and
			(sleep_until (volume_test_players crazy_marine_surprise_trigger) 1)
			(not (thespian_performance_is_blocked))
		)
	1)
	(performance_play_line "surprised_fall")
	(performance_play_line "shoot1")
	(performance_play_line "dialogue_760")
	(performance_play_line "shoot2")
	(performance_play_line "dialogue_770")
	(performance_play_line "shoot3")
	(performance_play_line "dialogue_780")
	(sleep (game_ticks_from_seconds 2))
	(performance_play_line "dialogue_840")
	(performance_play_line "shoot4")
	(sleep (game_ticks_from_seconds 1.5))
	(performance_play_line "dialogue_790")
	(begin (cs_shoot (performance_get_actor crazy) false) (cs_force_combat_status ai_current_actor 0) (sleep (game_ticks_from_seconds 1)))
	(performance_play_line "dialogue_800")
	(performance_play_line "shoot5")
	(sleep (game_ticks_from_seconds 1))
	(performance_play_line "dialogue_810")
	(begin (cs_shoot (performance_get_actor crazy) false) (cs_force_combat_status ai_current_actor 0))
	(performance_play_line "dialogue_820")
	(begin (cs_shoot (performance_get_actor crazy) false) (cs_force_combat_status ai_current_actor 0) (sleep (game_ticks_from_seconds 1.5)))
	(performance_play_line "dialogue_830")
	(performance_play_line "shoot4_2")
	(sleep (game_ticks_from_seconds 1.5))
	(performance_play_line "dialogue_850")
	(begin (cs_shoot (performance_get_actor crazy) false) (cs_force_combat_status ai_current_actor 0))
	(sleep_until
		(and
			(sleep_until (not (keep_crazy_alive)))
			(not (thespian_performance_is_blocked))
		)
	1)
	(performance_play_line "death")
	(object_destroy obj_crazymarine)
)

